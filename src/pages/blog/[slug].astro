---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { posts } from '../../data/content';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}));}
const {post} = Astro.props;
const youtubeId = post.youtubeId && /^[a-zA-Z0-9_-]{11}$/.test(post.youtubeId) ? post.youtubeId : undefined;
const date = new Date(`${post.date}T12:00:00Z`).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'Europe/London'});
---
<Layout title={post.title} description={post.excerpt}><div class="wrap"><section class="page-hero"><a href="/blog/" class="eyebrow">← All insights</a><h1>{post.title}</h1><p>{post.excerpt}</p></section><section class="page-section reading-layout"><aside class="reading-aside"><div><div class="eyebrow">Perspective</div><p>{post.category}</p></div><div><div class="eyebrow">Published</div><p><time datetime={post.date}>{date}</time></p></div><div><div class="eyebrow">{post.kind==='video'?'Watch':'Read'}</div><p>{post.readTime}</p></div></aside><article class="prose article-body">{post.editorialNote && <div class="notice">{post.editorialNote}</div>}{post.kind==='video' && <div class="video-frame" data-video-id={youtubeId} data-video-title={post.title}>{youtubeId ? <div><h2>A new perspective. On play.</h2><p>Load this video to connect to YouTube. YouTube’s privacy policy will then apply.</p><button class="button video-load" style="margin-top:20px" type="button">Load YouTube video <span aria-hidden="true">▷</span></button></div> : <div><div class="eyebrow">On the horizon</div><h2 style="margin:15px 0">Our next conversation.</h2><p>The video will appear here once it’s published. In the meantime, explore the ideas below.</p><a class="text-link" href="/blog/" style="margin-top:20px">Explore all insights <span aria-hidden="true">⟶</span></a></div>}</div>}{post.body.map(paragraph=><p>{paragraph}</p>)}<a href="/blog/" class="text-link" style="margin-top:20px">Back to insights <span aria-hidden="true">⟶</span></a></article></section></div><CTA/><script>
document.querySelector<HTMLButtonElement>('.video-load')?.addEventListener('click',()=>{const container=document.querySelector<HTMLElement>('[data-video-id]');const id=container?.dataset.videoId;if(!container||!id||!/^[a-zA-Z0-9_-]{11}$/.test(id))return;const frame=document.createElement('iframe');frame.src=`https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;frame.title=container.dataset.videoTitle||'YouTube video';frame.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';frame.allowFullscreen=true;frame.referrerPolicy='strict-origin-when-cross-origin';container.replaceChildren(frame);});
</script></Layout>

---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
const steps = [{title:'Understand before we advise.',text:'We listen to your people, explore your goals and look at the whole picture. The first task is agreeing which problem is worth solving.'},{title:'Make the complex clear.',text:'We assess your options and the trade-offs behind them. Together, we build a prioritised roadmap with a clear scope and realistic measures of success.'},{title:'Deliver with purpose.',text:'We work alongside your team, testing assumptions early and keeping progress visible. Practical delivery and appropriate controls go hand in hand.'},{title:'Leave lasting capability.',text:'Knowledge transfer is part of the work. We document the decisions, support adoption and equip your people to move forward with confidence.'}];
---
<Layout title="A considered approach"><div class="wrap"><section class="page-hero"><div class="eyebrow">Our approach</div><h1>Listen carefully.<br/>Think clearly. Move forward.</h1><p>Good technology decisions start with a better understanding of your business. We bring a calm, collaborative approach to complex challenges.</p></section><section class="page-section two-column"><div><h2>From ambition<br/>to action.</h2><p style="margin-top:20px">Independent thinking.<br/>Shared ownership.<br/>Measurable progress.</p></div><div class="steps">{steps.map(step=><article class="step"><div><h3>{step.title}</h3><p>{step.text}</p></div></article>)}</div></section></div><CTA/></Layout>

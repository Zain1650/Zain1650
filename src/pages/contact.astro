---
import Layout from '../layouts/Layout.astro';
import {site} from '../data/site';
---
<Layout title="Let’s talk about what’s next"><div class="wrap"><section class="page-hero"><div class="eyebrow">Start a conversation</div><h1>Ambitious plans?<br/>Let’s move them forward.</h1><p>Tell us what you’re working towards, what’s getting in the way and where you’d like a fresh perspective.</p></section><section class="page-section contact-grid"><div><h2>Good progress starts<br/>with a conversation.</h2><p>Whether you have a clear brief or an early idea, there’s a place to begin.</p><div class="contact-detail"><div class="eyebrow">Email</div>{site.contactEmail ? <a class="text-link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> : <p>Contact details will be available soon.</p>}</div><div class="contact-detail"><div class="eyebrow">Your enquiry</div><p class="form-note">This form prepares an email for you to review. It does not store your details or send a message automatically.</p></div></div><form class="contact-form" data-contact-email={site.contactEmail}><div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required maxlength="150" placeholder="Your name"/></div><div class="field"><label for="email">Work email</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@organisation.co.uk"/></div><div class="field full"><label for="organisation">Organisation</label><input id="organisation" name="organisation" autocomplete="organization" maxlength="200" placeholder="Your organisation (optional)"/></div><div class="field full"><label for="interest">Interested in</label><select id="interest" name="interest"><option>Let’s explore the possibilities</option><option>Cloud & Infrastructure</option><option>Cybersecurity</option><option>AI & Automation</option><option>Strategic Advisory</option></select></div><div class="field full"><label for="message">Your message</label><textarea id="message" name="message" required maxlength="4000" placeholder="What would you like to achieve?"></textarea></div><p class="form-note field full">Please avoid including confidential information. Read our <a href="/privacy/" style="text-decoration:underline">privacy notice</a>.</p><button class="button form-button" type="submit">Prepare enquiry <span aria-hidden="true">⟶</span></button><div class="form-status" hidden role="status" tabindex="-1"><p class="status-copy"></p><div class="field full" style="margin-top:15px"><label for="prepared-message">Your prepared enquiry</label><textarea id="prepared-message" readonly rows="8"></textarea></div><div style="display:flex;gap:20px;flex-wrap:wrap;margin-top:20px"><a class="button email-link" hidden>Open email app <span aria-hidden="true">↗</span></a><button class="text-link copy-enquiry" type="button" style="border:0;border-bottom:1px solid;background:transparent;color:inherit">Copy enquiry <span aria-hidden="true">⟶</span></button></div><p class="copy-status form-note" aria-live="polite"></p></div><noscript><p class="notice">Enable JavaScript to prepare an enquiry. No information has been sent.</p></noscript></form></section></div><script>
const form=document.querySelector<HTMLFormElement>('.contact-form');
form?.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const body=`Name: ${data.get('name')}\nEmail: ${data.get('email')}\nOrganisation: ${data.get('organisation')||'Not provided'}\nInterested in: ${data.get('interest')}\n\n${data.get('message')}`;const recipient=form.dataset.contactEmail;const status=form.querySelector<HTMLElement>('.form-status');const copy=form.querySelector<HTMLElement>('.status-copy');const preview=form.querySelector<HTMLTextAreaElement>('#prepared-message');const link=form.querySelector<HTMLAnchorElement>('.email-link');if(preview)preview.value=body;if(copy)copy.textContent=recipient?'Your enquiry is prepared. Open your email app to review and send it, or copy the text below. Nothing has been sent yet.':'The contact email is not configured yet. Your enquiry is ready to copy below; nothing has been sent.';if(link&&recipient){link.href=`mailto:${recipient}?subject=${encodeURIComponent(`Website enquiry — ${data.get('interest')}`)}&body=${encodeURIComponent(body)}`;link.hidden=false;}if(status){status.hidden=false;status.focus();}});
form?.querySelector('.copy-enquiry')?.addEventListener('click',async()=>{const preview=form.querySelector<HTMLTextAreaElement>('#prepared-message');const status=form.querySelector<HTMLElement>('.copy-status');if(!preview||!status)return;try{await navigator.clipboard.writeText(preview.value);status.textContent='Enquiry copied.';}catch{preview.focus();preview.select();status.textContent='Select and copy the prepared enquiry above.';}});
</script></Layout>

---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
interface Props { title?: string; description?: string; }
const { title = 'Strategic technology. Stronger tomorrow.', description = 'Independent technology consultancy. Cloud, cybersecurity, AI and strategic advice that turn complexity into progress.' } = Astro.props;
const path = Astro.url.pathname;
const links = [['Services','/services/'], ['Approach','/approach/'], ['Case studies','/case-studies/'], ['Insights','/blog/'], ['About','/about/']];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="color-scheme" content="light dark" />
    <title>{title} — Z Performance Systems</title><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={`${title} — Z Performance Systems`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:image" content={new URL("/images/architecture.jpg", Astro.site)} /><meta name="twitter:card" content="summary_large_image" /><meta property="og:url" content={new URL(path, Astro.site)} />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('zp-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <Logo />
      <nav id="main-nav" class="main-nav" aria-label="Main navigation">{links.map(([label,href]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav>
      <div class="header-actions">
        <button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme"><svg class="moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z"/></svg><svg class="sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2"/></svg></button>
        <a class="button header-cta" href="/contact/">Let's talk <span aria-hidden="true">⟶</span></a>
        <button class="menu-toggle" aria-label="Menu" type="button" aria-expanded="false" aria-controls="main-nav"><span>Menu</span><span class="menu-lines" aria-hidden="true"></span></button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="wrap">
      <div class="footer-main"><Logo /><nav aria-label="Footer navigation">{links.map(([label,href]) => <a href={href}>{label}</a>)}<a href="/contact/">Contact</a></nav><div class="footer-statement">People. Technology. Progress.<span>A more resilient, ambitious tomorrow.</span></div><a class="footer-up" href="#main" aria-label="Back to top">↑</a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Z Performance Systems.</span><span>Independent thinking. Meaningful progress.</span><a href="/privacy/">Privacy & cookies</a></div>
    </div></footer>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
      function updateThemeLabel() { const dark = document.documentElement.dataset.theme === 'dark'; themeButton?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} mode`); themeButton?.setAttribute('title', `Switch to ${dark ? 'light' : 'dark'} mode`); }
      updateThemeLabel();
      themeButton?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('zp-theme', next); } catch {} updateThemeLabel(); });
      document.querySelector('.menu-toggle')?.addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; const open = button.getAttribute('aria-expanded') !== 'true'; button.setAttribute('aria-expanded', String(open)); document.querySelector('.site-header')?.classList.toggle('menu-open', open); });
      document.addEventListener('keydown', (e) => { if(e.key === 'Escape') { document.querySelector('.menu-toggle')?.setAttribute('aria-expanded','false'); document.querySelector('.site-header')?.classList.remove('menu-open'); } });
    </script>
  </body>
</html>
